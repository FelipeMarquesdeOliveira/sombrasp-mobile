# Copie para .env só se quiser trocar a fonte dos dados. Sem .env o app usa o mock.
#
# EXPO_PUBLIC_FONTE_DADOS
#   mock -> dados simulados de src/services/mock (padrão da entrega)
#   api  -> API REST do SombraSP feita na disciplina de SOA (repositório sombrasp-soa)
#
# EXPO_PUBLIC_API_URL
#   Endereço da API de SOA. No simulador iOS, localhost é o próprio Mac.
#   No emulador Android use http://10.0.2.2:8085; no celular, o IP do computador na rede.
#
# As rotas usadas são GET públicas (/alertas/hoje, /alertas, /pontos/proximos, /pontos/{id}),
# então o app não precisa de token, senha nem chave.

EXPO_PUBLIC_FONTE_DADOS=mock
EXPO_PUBLIC_API_URL=http://localhost:8085
